# -----------------------------------------------------------------------------
# Alarmes - exemplo de configuracao para firebase_Function/functions/alarms.py
# -----------------------------------------------------------------------------
# Copie este arquivo para .env e ajuste os valores do seu ponto medido.
# Recife/PE: VNOM tipico fase-neutro = 220 V

# Base eletrica
ALARM_VNOM=220

# Taxa esperada de chegada de dados (segundos)
# Dev atual: 5
# Producao: 60 (1 min) ou 300 (5 min)
ALARM_EXPECTED_INTERVAL_S=5

# STREAM_STALE: alerta quando gap > ALARM_EXPECTED_INTERVAL_S * ALARM_STALE_MULTIPLIER
ALARM_STALE_MULTIPLIER=3

# Debounce por amostras
ALARM_DELAY_WARNING_SAMPLES=2
ALARM_DELAY_CRITICAL_SAMPLES=1

# Histerese/deadband
ALARM_DEADBAND_V=1.0
ALARM_DEADBAND_F_HZ=0.02
ALARM_DEADBAND_PF=0.01
ALARM_DEADBAND_ANGLE_DEG=1.0

# -----------------------------------------------------------------------------
# Limites opcionais (regras ficam suprimidas se nao configurar)
# -----------------------------------------------------------------------------
# Corrente nominal do ponto (A)
# ALARM_I_RATED_A=400

# Limite de potencia ativa (kW)
# ALARM_P_MAX_KW=500

# Potencia nominal para regra de fluxo reverso (kW)
# ALARM_P_NOM_KW=500

# Limite aparente (kVA), usado para Q/S
# ALARM_S_MAX_KVA=550

# Limite de reativo (kvar), usado em Prev
# ALARM_Q_LIMIT_KVAR=120

# Orcamento diario de energia acumulada por fase (kWh)
# ALARM_E_DAILY_BUDGET_KWH=10000

# -----------------------------------------------------------------------------
# Energia travada (desabilitado por padrao)
# -----------------------------------------------------------------------------
ALARM_ENABLE_ENERGY_STALL=false
ALARM_ENERGY_STALL_WARNING_S=900
ALARM_ENERGY_STALL_CRITICAL_S=3600
ALARM_ENERGY_STALL_POWER_FLOOR_W=100
ALARM_ENERGY_STALL_DELTA_EPSILON_KWH=0.0001
